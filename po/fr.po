msgid "外面正在打雷下雨，雨会斜着打在窗上。"
msgstr "Il y a de l'orage ; la pluie fouette la fenêtre."

msgid "外面在下{what}，雨点砸在玻璃上，路面已经湿得发亮。"
msgstr "{what} dehors — les gouttes frappent la vitre et la route brille."

msgid "外面飘着{what}，细得几乎看不出雨丝。"
msgstr "{what} dehors, à peine quelques gouttes."

msgid "外面在下{what}，这种时候最适合发呆。"
msgstr "{what} dehors — le moment idéal pour rêvasser."

msgid "外面下着{what}，雪花是慢慢飘下来的。"
msgstr "{what} dehors ; les flocons descendent doucement."

msgid "外面起雾了，远处的屋顶已经看不清。"
msgstr "Le brouillard est arrivé ; on ne voit plus les toits."

msgid "云很厚，今天的光是匀匀地洒下来的，没有影子。"
msgstr "Nuages épais aujourd'hui — une lumière uniforme, sans ombres."

msgid "太阳几乎在头顶，{side}边的天空最亮。"
msgstr "Le soleil est presque au zénith ; le ciel est plus clair au {side}."

msgid "太阳在{side}方，仰角 {alt}°，影子短短的。"
msgstr "Le soleil est au {side} à {alt}° ; les ombres sont courtes."

msgid "太阳在{side}方只有 {alt}° 高，光斜斜地照进来。"
msgstr "Le soleil n'est qu'à {alt}° au {side} ; la lumière entre de biais."

msgid "{side}边的天被染成了橘色，这是今天最好的光。"
msgstr "Le ciel au {side} s'est teinté d'orange — la plus belle lumière du jour."

msgid "天光只剩 {left}。"
msgstr "Il ne reste que {left} de lumière."

msgid "太阳刚刚离开。"
msgstr "Le soleil vient de disparaître."

msgid "太阳正在{side}方落到地平线下，{tail}"
msgstr "Le soleil descend sous l'horizon au {side} ; {tail}"

msgid "暮色最浓的时候，天边还剩一线橘红。"
msgstr "Au plus fort du crépuscule, un dernier fil orange à l'horizon."

