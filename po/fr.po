msgstr "{why}\n\nLe paquet est téléchargé dans :\n    {path}\n\nSi vous êtes sûr de ce fichier, installez-le manuellement :\n    sudo apt-get install -y -- \"{path}\"\n\nVersions : {url}"

msgid "下载安装包失败"
